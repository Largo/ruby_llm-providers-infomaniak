# Copy to test/.env (gitignored) and fill in. Used by bin/console, `rake live` and `rake models`.

# API token with the AI Tools scope (Infomaniak Manager > API tokens).
INFOMANIAK_API_KEY=

# Optional: looked up with GET /1/ai when the token reaches exactly one AI Tools product.
INFOMANIAK_PRODUCT_ID=

# Model for bin/console and the live tests.
INFOMANIAK_MODEL=moonshotai/Kimi-K2.6

# Optional: an embedding model id to include embeddings in `rake live`.
INFOMANIAK_EMBEDDING_MODEL=

# Optional: log every request and response body.
# RUBYLLM_DEBUG=1
